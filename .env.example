POSTGRES_USER=yandeh
POSTGRES_PASSWORD=yandeh
POSTGRES_DB=yandeh
DATABASE_URL=postgres://yandeh:yandeh@localhost:5432/yandeh
# Banco só dos testes da API (default: o DATABASE_URL com sufixo _test, ex. yandeh_test).
# TEST_DATABASE_URL=postgres://yandeh:yandeh@localhost:5432/yandeh_test
API_PORT=3333
# Host da API (Fastify). Default 0.0.0.0 para aceitar conexões do Docker/host.
HOST=0.0.0.0
WEB_PORT=5173
VITE_API_URL=http://localhost:3333
# Fuso da data civil do pedido (YYYY-MM-DD). Default: America/Fortaleza (CE, sem horário de verão).
BUSINESS_TIMEZONE=America/Fortaleza
